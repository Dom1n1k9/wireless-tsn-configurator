[Unit]
Description=WTSN AI Policy Engine (autonomous TSN decisions)
After=network-online.target mosquitto.service wtsn-webgui.service
Wants=network-online.target mosquitto.service wtsn-webgui.service

[Service]
EnvironmentFile=/etc/wtsn/env
Type=simple
User=wtsn
WorkingDirectory=/home/wtsn/wtsn-ai
ExecStart=/usr/bin/python3 /home/wtsn/wtsn-ai/policy_engine.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
