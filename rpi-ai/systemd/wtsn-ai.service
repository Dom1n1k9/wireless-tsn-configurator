[Unit]
Description=WTSN AI Vision (YOLO detection on ESP32-CAM)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
EnvironmentFile=/etc/wtsn/env
Type=simple
User=wtsn
WorkingDirectory=/home/wtsn/wtsn-ai
ExecStart=/usr/bin/python3 /home/wtsn/wtsn-ai/vision_service.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
