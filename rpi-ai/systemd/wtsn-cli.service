[Unit]
Description=WTSN CNC controller (wtsn-cli)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
EnvironmentFile=/etc/wtsn/env
Type=simple
User=wtsn
WorkingDirectory=/home/wtsn/wtsn-configurator
ExecStart=/home/wtsn/wtsn-configurator/build/wtsn-cli --headless --db /home/wtsn/wtsn.db --mqtt-host localhost --mqtt-port 1883
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
