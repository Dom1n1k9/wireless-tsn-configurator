[Unit]
Description=WTSN Web GUI
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
EnvironmentFile=/etc/wtsn/env
Type=simple
User=wtsn
WorkingDirectory=/home/wtsn/wtsn-configurator
Environment=WTSN_BROKER=localhost:1883
ExecStart=/usr/bin/python3 /home/wtsn/wtsn-configurator/webgui.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
