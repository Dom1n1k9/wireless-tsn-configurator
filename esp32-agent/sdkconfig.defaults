# WiFi + MQTT
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# LWIP
CONFIG_LWIP_DHCP_GET_HOSTNAME=y

# MQTT (ESP-IDF built-in)
CONFIG_MQTT_PROTOCOL_311=y

# Reduce log noise in release
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Flash size (BLE firmware is larger)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom partition table with a 2M factory app (BLE binary ~1.2M > 1M default)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="./partitions.csv"

# Bluetooth LE (NimBLE host) for the micro:bit BLE display panel
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
