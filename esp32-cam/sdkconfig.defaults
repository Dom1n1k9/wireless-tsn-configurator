# ESP32-CAM: WiFi + MQTT agent + MJPEG stream
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_LWIP_DHCP_GET_HOSTNAME=y
CONFIG_MQTT_PROTOCOL_311=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=1000

# Allow plain-HTTP OTA URLs (web GUI serves the image on the trusted LAN).
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# microSD recording: FAT + SPI SD on the AI-Thinker VSPI pins (2/13/14/15)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_SPI_FLASH_ERASE_SIZE=4096

# SD-SPI ISR does not need to live in IRAM (no deep-sleep capture) and this
# frees ~2 KB of IRAM so the FATFS/SD recording path links with the camera.
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n
